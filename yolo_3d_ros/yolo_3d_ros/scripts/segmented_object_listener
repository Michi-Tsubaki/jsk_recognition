#!/usr/bin/env python3
"""Print object names, 3D positions, and reconstructed NumPy array shapes."""

from __future__ import annotations

import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from yolo_3d_msgs.msg import SegmentedObject3DArray

from yolo_3d_ros.pointcloud import PointCloudFormatError, pointcloud2_to_array


class SegmentedObjectListener(Node):
    def __init__(self) -> None:
        super().__init__("segmented_object_listener")
        self.declare_parameter("topic", "/yolo_3d/segmented_objects")
        self._subscription = self.create_subscription(
            SegmentedObject3DArray,
            str(self.get_parameter("topic").value),
            self._on_objects,
            qos_profile_sensor_data,
        )

    def _on_objects(self, message: SegmentedObject3DArray) -> None:
        descriptions: list[str] = []
        for index, item in enumerate(message.objects):
            if not item.detection.results:
                continue
            result = item.detection.results[0]
            try:
                xyz, rgb = pointcloud2_to_array(item.point_cloud)
            except PointCloudFormatError as exc:
                self.get_logger().warning(f"object[{index}] has an invalid PointCloud2: {exc}")
                continue
            points = xyz.reshape(-1, 3)
            valid_count = int(
                np.count_nonzero(
                    np.isfinite(points).all(axis=1)
                    & (np.linalg.norm(points, axis=1) > np.finfo(np.float32).eps)
                )
            )
            position = result.pose.pose.position
            descriptions.append(
                f"object[{index}] name={result.hypothesis.class_id!r} "
                f"confidence={result.hypothesis.score:.3f} "
                f"position=({position.x:.3f}, {position.y:.3f}, {position.z:.3f}) m "
                f"xyz.shape={xyz.shape} rgb.shape={rgb.shape} valid_points={valid_count}"
            )
        if descriptions:
            self.get_logger().info("\n" + "\n".join(descriptions))


def main(args: list[str] | None = None) -> None:
    rclpy.init(args=args)
    node = SegmentedObjectListener()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
