#!/usr/bin/env python3
"""Visualize segmented per-object PointCloud2 payloads and 3D AABBs with Open3D."""

from __future__ import annotations

import threading
from dataclasses import dataclass

import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from yolo_3d_msgs.msg import SegmentedObject3DArray

from yolo_3d_ros.pointcloud import PointCloudFormatError, pointcloud2_to_array


@dataclass(slots=True)
class ViewerObject:
    points: np.ndarray
    colors: np.ndarray
    bbox_min: np.ndarray
    bbox_max: np.ndarray
    class_name: str
    score: float
    position: np.ndarray


class Open3DObjectViewer(Node):
    """Show all or one segmented object point cloud in an Open3D window."""

    def __init__(self) -> None:
        super().__init__("yolo_3d_open3d_viewer")
        try:
            import open3d as o3d
        except ImportError as exc:
            raise RuntimeError(
                "Open3D is not installed. Run 'uv sync --active --extra open3d' "
                "inside the yolo_3d_ros package directory."
            ) from exc

        self._o3d = o3d
        self.declare_parameter("topic", "/yolo_3d/segmented_objects")
        self.declare_parameter("object_index", -1)
        self.declare_parameter("class_name", "")
        self.declare_parameter("point_size", 2.0)

        self._object_index = int(self.get_parameter("object_index").value)
        self._class_name = str(self.get_parameter("class_name").value).strip()
        self._lock = threading.Lock()
        self._latest: list[ViewerObject] | None = None
        self._first_render = True

        self._visualizer = o3d.visualization.Visualizer()
        if not self._visualizer.create_window(
            window_name="yolo_3d_ros segmented objects",
            width=1280,
            height=800,
        ):
            raise RuntimeError("Open3D could not create a window; check DISPLAY/Wayland forwarding")
        render_options = self._visualizer.get_render_option()
        if render_options is not None:
            render_options.point_size = float(self.get_parameter("point_size").value)

        self._subscription = self.create_subscription(
            SegmentedObject3DArray,
            str(self.get_parameter("topic").value),
            self._on_objects,
            qos_profile_sensor_data,
        )
        self._timer = self.create_timer(1.0 / 30.0, self._update_window)
        self.get_logger().info(
            "Open3D viewer ready. object_index=-1 displays all objects; class_name can filter."
        )

    def _on_objects(self, message: SegmentedObject3DArray) -> None:
        selected: list[ViewerObject] = []
        descriptions: list[str] = []
        for index, item in enumerate(message.objects):
            if not item.detection.results:
                continue
            result = item.detection.results[0]
            class_name = result.hypothesis.class_id
            if self._object_index >= 0 and index != self._object_index:
                continue
            if self._class_name and class_name != self._class_name:
                continue

            try:
                xyz, rgb = pointcloud2_to_array(item.point_cloud)
            except PointCloudFormatError as exc:
                self.get_logger().warning(f"Skipping invalid object point cloud: {exc}")
                continue
            points = xyz.reshape(-1, 3)
            colors = rgb.reshape(-1, 3)
            valid = np.isfinite(points).all(axis=1) & (
                np.linalg.norm(points, axis=1) > np.finfo(np.float32).eps
            )
            if not np.any(valid):
                continue

            center = item.detection.bbox.center.position
            size = item.detection.bbox.size
            bbox_center = np.array([center.x, center.y, center.z], dtype=np.float64)
            bbox_size = np.array([size.x, size.y, size.z], dtype=np.float64)
            position_msg = result.pose.pose.position
            position = np.array(
                [position_msg.x, position_msg.y, position_msg.z],
                dtype=np.float64,
            )
            selected.append(
                ViewerObject(
                    points=np.ascontiguousarray(points[valid], dtype=np.float64),
                    colors=np.ascontiguousarray(colors[valid] / 255.0, dtype=np.float64),
                    bbox_min=bbox_center - bbox_size / 2.0,
                    bbox_max=bbox_center + bbox_size / 2.0,
                    class_name=class_name,
                    score=float(result.hypothesis.score),
                    position=position,
                )
            )
            descriptions.append(
                f"{class_name} conf={result.hypothesis.score:.3f} "
                f"position=({position[0]:.3f}, {position[1]:.3f}, {position[2]:.3f}) m"
            )

        if not selected:
            return
        with self._lock:
            self._latest = selected
        self.get_logger().info(" | ".join(descriptions))

    def _update_window(self) -> None:
        with self._lock:
            latest = self._latest
            self._latest = None

        if latest is not None:
            self._visualizer.clear_geometries()
            for index, item in enumerate(latest):
                point_cloud = self._o3d.geometry.PointCloud()
                point_cloud.points = self._o3d.utility.Vector3dVector(item.points)
                point_cloud.colors = self._o3d.utility.Vector3dVector(item.colors)
                self._visualizer.add_geometry(
                    point_cloud,
                    reset_bounding_box=self._first_render and index == 0,
                )

                bbox = self._o3d.geometry.AxisAlignedBoundingBox(
                    min_bound=item.bbox_min,
                    max_bound=item.bbox_max,
                )
                line_set = self._o3d.geometry.LineSet.create_from_axis_aligned_bounding_box(bbox)
                self._visualizer.add_geometry(line_set, reset_bounding_box=False)

            if self._first_render:
                self._visualizer.reset_view_point(True)
                self._first_render = False

        if not self._visualizer.poll_events():
            if rclpy.ok():
                rclpy.shutdown()
            return
        self._visualizer.update_renderer()

    def destroy_node(self) -> bool:
        self._visualizer.destroy_window()
        return super().destroy_node()


def main(args: list[str] | None = None) -> None:
    rclpy.init(args=args)
    node: Open3DObjectViewer | None = None
    try:
        node = Open3DObjectViewer()
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node is not None:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
