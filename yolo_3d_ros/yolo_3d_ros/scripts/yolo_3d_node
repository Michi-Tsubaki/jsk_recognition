#!@YOLO_3D_VENV_PYTHON@

"""ROS 2 node that turns YOLO image masks into 3D object point clouds."""

from __future__ import annotations

import threading
import time
import traceback
from pathlib import Path

import rclpy
from ament_index_python.packages import get_package_share_directory
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, qos_profile_sensor_data
from sensor_msgs.msg import Image, PointCloud2
from vision_msgs.msg import BoundingBox3DArray, Detection3DArray
from yolo_3d_msgs.msg import SegmentedObject3DArray

from yolo_3d_ros.core import ExtractionConfig, extract_segmented_instances
from yolo_3d_ros.inference import YOLOSegmenter
from yolo_3d_ros.pointcloud import PointCloudFormatError, pointcloud2_to_array
from yolo_3d_ros.ros_messages import (
    bgr_image_message,
    bounding_box3d_array,
    build_output_messages,
)


def _resolve_model(model: str) -> str:
    """Resolve a relative model name against the installed package share directory."""

    if "://" in model:
        return model

    candidate = Path(model).expanduser()
    if candidate.is_absolute():
        return str(candidate)
    if candidate.is_file():
        return str(candidate.resolve())

    share = Path(get_package_share_directory("yolo_3d_ros"))
    package_candidates = [share / candidate, share / "models" / candidate.name]
    for package_candidate in package_candidates:
        if package_candidate.is_file():
            return str(package_candidate)

    # Preserve Ultralytics' normal behavior for an explicitly supplied model name.
    # The package default is models/yolo26m-seg.pt and should resolve above after a
    # normal colcon build.
    return model


class Yolo3DNode(Node):
    """Subscribe to an organized XYZRGB cloud and publish segmented 3D objects."""

    def __init__(self) -> None:
        super().__init__("yolo_3d")
        self.declare_parameter("input_topic", "/camera/depth/points")
        self.declare_parameter("detections_topic", "/yolo_3d/detections")
        self.declare_parameter("segmented_objects_topic", "/yolo_3d/segmented_objects")
        self.declare_parameter("segmented_points_topic", "/yolo_3d/segmented_points")
        self.declare_parameter("bounding_boxes_topic", "/yolo_3d/bounding_boxes")
        self.declare_parameter("debug_image_topic", "/yolo_3d/debug_image")
        self.declare_parameter("model", "models/yolo26m-seg.pt")
        self.declare_parameter("confidence", 0.25)
        self.declare_parameter("iou", 0.7)
        self.declare_parameter("image_size", 640)
        self.declare_parameter("device", "")
        self.declare_parameter("classes", [-1])
        self.declare_parameter("mask_threshold", 0.5)
        self.declare_parameter("min_points", 100)
        self.declare_parameter("min_depth_m", 0.05)
        self.declare_parameter("max_depth_m", 10.0)
        self.declare_parameter("bbox_percentile", 1.0)
        self.declare_parameter("max_points_per_object", 25_000)
        self.declare_parameter("random_seed", 0)
        self.declare_parameter("publish_merged_cloud", True)
        self.declare_parameter("publish_debug_image", True)
        self.declare_parameter("log_every_n_frames", 1)

        classes = [int(value) for value in self.get_parameter("classes").value]
        if not classes or classes[0] < 0:
            classes = None

        self._extract_config = ExtractionConfig(
            mask_threshold=float(self.get_parameter("mask_threshold").value),
            min_points=int(self.get_parameter("min_points").value),
            min_depth_m=float(self.get_parameter("min_depth_m").value),
            max_depth_m=float(self.get_parameter("max_depth_m").value),
            bbox_percentile=float(self.get_parameter("bbox_percentile").value),
            max_points_per_object=int(self.get_parameter("max_points_per_object").value),
            random_seed=int(self.get_parameter("random_seed").value),
        )
        self._extract_config.validate()
        self._publish_merged = bool(self.get_parameter("publish_merged_cloud").value)
        self._publish_debug = bool(self.get_parameter("publish_debug_image").value)
        self._log_every = max(1, int(self.get_parameter("log_every_n_frames").value))

        configured_model = str(self.get_parameter("model").value)
        resolved_model = _resolve_model(configured_model)
        resolved_path = Path(resolved_model).expanduser()
        if resolved_path.is_file():
            self.get_logger().info(f"Loading segmentation model: {resolved_path}")
        elif resolved_path.is_absolute() or configured_model.startswith("models/"):
            raise RuntimeError(
                f"YOLO model checkpoint was not found: {resolved_path}. Rebuild with "
                "YOLO_3D_DOWNLOAD_MODEL=ON, or set the model parameter to an existing "
                "checkpoint path."
            )
        else:
            self.get_logger().warning(
                f"Model {configured_model!r} is not a local file. Ultralytics may try "
                "to resolve or download it at runtime."
            )

        self._segmenter = YOLOSegmenter(
            model=resolved_model,
            confidence=float(self.get_parameter("confidence").value),
            iou=float(self.get_parameter("iou").value),
            image_size=int(self.get_parameter("image_size").value),
            device=str(self.get_parameter("device").value),
            classes=classes,
        )
        if not rclpy.ok():
            raise KeyboardInterrupt

        output_qos = QoSProfile(depth=5, reliability=ReliabilityPolicy.RELIABLE)

        self._detection_publisher = self.create_publisher(
            Detection3DArray,
            str(self.get_parameter("detections_topic").value),
            output_qos,
        )
        self._objects_publisher = self.create_publisher(
            SegmentedObject3DArray,
            str(self.get_parameter("segmented_objects_topic").value),
            output_qos,
        )
        self._points_publisher = self.create_publisher(
            PointCloud2,
            str(self.get_parameter("segmented_points_topic").value),
            output_qos,
        )
        self._boxes_publisher = self.create_publisher(
            BoundingBox3DArray,
            str(self.get_parameter("bounding_boxes_topic").value),
            output_qos,
        )
        self._debug_publisher = self.create_publisher(
            Image,
            str(self.get_parameter("debug_image_topic").value),
            output_qos,
        )
        self._subscription = self.create_subscription(
            PointCloud2,
            str(self.get_parameter("input_topic").value),
            self._on_pointcloud,
            qos_profile_sensor_data,
        )
        self._inference_lock = threading.Lock()
        self._processed_frames = 0
        self._dropped_frames = 0
        self._last_no_detection_log = 0.0
        self.get_logger().info(
            "Ready. The input cloud must be organized and pixel-aligned with its packed RGB field."
        )

    def _log_no_detection(self, reason: str) -> None:
        now = time.monotonic()
        if now - self._last_no_detection_log >= 5.0:
            self.get_logger().debug(f"No output published: {reason}")
            self._last_no_detection_log = now

    def _on_pointcloud(self, cloud: PointCloud2) -> None:
        if not self._inference_lock.acquire(blocking=False):
            self._dropped_frames += 1
            return
        try:
            if cloud.height <= 1:
                self.get_logger().error(
                    "Received an unorganized PointCloud2 (height <= 1). Enable the RealSense "
                    "pointcloud.ordered_pc parameter so segmentation pixels map to 3D points."
                )
                return
            try:
                xyz, rgb = pointcloud2_to_array(cloud)
            except PointCloudFormatError as exc:
                self.get_logger().error(f"PointCloud2 conversion failed: {exc}")
                return

            prediction = self._segmenter.predict(rgb, annotate=self._publish_debug)
            if prediction.class_ids.size == 0 or prediction.masks.shape[0] == 0:
                self._log_no_detection("YOLO returned no instance masks")
                return

            instances = extract_segmented_instances(
                xyz=xyz,
                rgb=rgb,
                masks=prediction.masks,
                class_ids=prediction.class_ids,
                scores=prediction.scores,
                names=prediction.names,
                config=self._extract_config,
            )
            if not instances:
                self._log_no_detection(
                    "all masks had fewer than min_points valid 3D points or were "
                    "outside depth limits"
                )
                return

            detections, segmented_objects, merged_cloud = build_output_messages(
                cloud.header,
                instances,
            )
            # Output publishers are intentionally reached only after at least one valid object.
            self._detection_publisher.publish(detections)
            self._objects_publisher.publish(segmented_objects)
            if self._publish_merged:
                self._points_publisher.publish(merged_cloud)
            self._boxes_publisher.publish(bounding_box3d_array(cloud.header, instances))
            if self._publish_debug and prediction.annotated_bgr is not None:
                self._debug_publisher.publish(
                    bgr_image_message(cloud.header, prediction.annotated_bgr)
                )

            self._processed_frames += 1
            if self._processed_frames % self._log_every == 0:
                descriptions = []
                for instance in instances:
                    x, y, z = instance.position
                    descriptions.append(
                        f"{instance.class_name} conf={instance.score:.3f} "
                        f"position=({x:.3f}, {y:.3f}, {z:.3f}) m "
                        f"points={instance.source_point_count}"
                    )
                self.get_logger().info(" | ".join(descriptions))
        except Exception as exc:  # noqa: BLE001 - callback must keep the node alive.
            self.get_logger().error(
                f"Unhandled point-cloud callback error: {exc}\n{traceback.format_exc()}"
            )
        finally:
            self._inference_lock.release()


def main(args: list[str] | None = None) -> None:
    rclpy.init(args=args)
    node: Yolo3DNode | None = None
    try:
        node = Yolo3DNode()
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        if node is not None:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
