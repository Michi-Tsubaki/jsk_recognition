<?xml version="1.0"?>
<package format="3">
  <name>yolo_3d_ros</name>
  <version>0.1.1</version>
  <description>
    Segment organized RGB PointCloud2 streams with Ultralytics YOLO and publish
    vision_msgs 3D detections plus per-object colored point clouds.
  </description>
  <maintainer email="tsubaki@jsk.t.u-tokyo.ac.jp">Michitoshi Tsubaki</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>curl</build_depend>

  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_xml</depend>
  <depend>launch_ros</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>yolo_3d_msgs</depend>

  <exec_depend>vision_msgs_rviz_plugins</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
