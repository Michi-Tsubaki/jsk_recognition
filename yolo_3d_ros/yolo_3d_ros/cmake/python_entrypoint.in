#!/usr/bin/env bash
set -euo pipefail

venv_python="@YOLO_3D_VENV_PYTHON@"
script="@SCRIPT_PATH@"

if [[ ! -x "${venv_python}" ]]; then
  echo "error: yolo_3d_ros Python environment is missing: ${venv_python}" >&2
  echo "Run: colcon build --packages-up-to yolo_3d_ros --symlink-install" >&2
  exit 1
fi

exec "${venv_python}" "${script}" "$@"
